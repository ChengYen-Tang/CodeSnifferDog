@inherits LayoutComponentBase

@using CodeSnifferDog.Server.Services.Projects.Sidebar
@using CodeSnifferDog.Server.Shared.Projects
@inject ISnapshotService SnapshotService
@inject NavigationManager NavigationManager
@code {
    private ProjectSidebarSnapshotDto? _initialSidebarSnapshot;

    protected override async Task OnInitializedAsync()
    {
        _initialSidebarSnapshot = await SnapshotService.GetSnapshotAsync(
            ExtractSelectedProjectIdFromUri(),
            CancellationToken.None);
    }

    private Guid? ExtractSelectedProjectIdFromUri()
    {
        Uri uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        string relativePath = NavigationManager.ToBaseRelativePath(uri.ToString()).Trim('/');
        return ProjectSidebarRouteSelection.ExtractSelectedProjectId(uri, relativePath);
    }
}

<a class="skip-link" href="#main-content">Skip to main content</a>

<div class="page">
    <aside class="sidebar" aria-label="Project navigation">
        <CodeSnifferDog.Server.Client.Layout.NavMenu InitialSnapshot="_initialSidebarSnapshot" />
    </aside>

    <main id="main-content" tabindex="-1">
        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
