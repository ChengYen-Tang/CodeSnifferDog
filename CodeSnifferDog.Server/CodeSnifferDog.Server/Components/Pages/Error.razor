@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<div class="dashboard-page state-page">
    <section class="state-card state-card-error" aria-labelledby="error-title">
        <div class="state-code">Error</div>
        <h1 id="error-title" class="state-title">We couldn't complete that request</h1>
        <p class="state-copy">An unexpected application error occurred. You can return to the project intake page and try again.</p>

        @if (ShowRequestId)
        {
            <p class="state-request-id">
                <strong>Request ID:</strong> <code>@RequestId</code>
            </p>
        }

        <details class="state-details">
            <summary>Development guidance</summary>
            <p>
                Use the <strong>Development</strong> environment to display detailed error information while debugging locally.
            </p>
            <p>
                Do not enable it in deployed applications because exception details can expose sensitive information.
            </p>
        </details>

        <a class="btn btn-primary state-action" href="/">Back to new project</a>
    </section>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
