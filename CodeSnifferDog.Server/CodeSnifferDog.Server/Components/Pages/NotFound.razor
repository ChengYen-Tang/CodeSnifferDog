@page "/not-found"
@layout MainLayout

<PageTitle>Page Not Found</PageTitle>

<div class="dashboard-page state-page">
    <section class="state-card" aria-labelledby="not-found-title">
        <div class="state-code">404</div>
        <h1 id="not-found-title" class="state-title">Page not found</h1>
        <p class="state-copy">The page may have moved, or the link may no longer be available.</p>
        <a class="btn btn-primary state-action" href="/">Back to new project</a>
    </section>
</div>
