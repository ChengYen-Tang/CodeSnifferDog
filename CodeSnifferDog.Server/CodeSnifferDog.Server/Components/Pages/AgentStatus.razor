@page "/agent-status"
@rendermode InteractiveServer

<PageTitle>Agent Status</PageTitle>

@code {
    private readonly IReadOnlyList<AgentGroup> _agentGroups =
    [
        new(
            "TG-001",
            "Controllers + Services",
            "Running",
            [
                new("Rule Review Agent", "Created 10:14", "Running"),
                new("Review Verifier Agent", "Created 10:15", "Waiting"),
                new("Report Aggregator", "Created 10:16", "Waiting"),
                new("Report Verifier", "Created 10:16", "Waiting")
            ]),
        new(
            "TG-002",
            "Repositories + Models",
            "Running",
            [
                new("Rule Review Agent", "Created 10:13", "Running"),
                new("Review Verifier Agent", "Created 10:14", "Waiting")
            ]),
        new(
            "TG-003",
            "Interop Boundary",
            "Completed",
            [
                new("Rule Review Agent", "Created 10:08", "Completed"),
                new("Review Verifier Agent", "Created 10:08", "Completed"),
                new("Report Aggregator", "Created 10:09", "Completed"),
                new("Report Verifier", "Created 10:09", "Completed")
            ])
    ];

    private readonly IReadOnlyList<HistoryEntry> _history =
    [
        HistoryEntry.Input("Start review for task group TG-001 using memory-leak.md."),
        HistoryEntry.Output("I will inspect the scope entry files first, then follow ownership across reconnect, session lifecycle, and event subscription paths before submitting issues or a no-issue conclusion."),
        HistoryEntry.Tool("RunRipgrepCommand", "rg -n \"Connected|Disconnected|Dispose|CancellationToken\" Payment.Service", "18 matches across 6 files"),
        HistoryEntry.Tool("RunShellCommand", "Get-ChildItem Payment.Service -Recurse -Filter *.cs", "42 files"),
        HistoryEntry.Output("The reconnect path attaches a handler in SessionCache, then replacement is delegated through RetryCoordinator. I need to inspect WorkerSession before deciding whether the old handler is detached on cancellation."),
        HistoryEntry.Tool("RunRipgrepCommand", "rg -n \"class WorkerSession|event|OnConnected\" Payment.Service", "7 matches across 3 files"),
        HistoryEntry.Compaction("Context automatically compacted"),
        HistoryEntry.Input("Verifier rejected the first result. Continue with the missing cross-scope evidence."),
        HistoryEntry.Output("Rejected. The issue is plausible, but the submitted evidence does not yet prove whether the previous session remains reachable after reconnect. Follow WorkerSession ownership and submit an updated issue with the missing evidence chain."),
        HistoryEntry.Output("I followed WorkerSession and ConnectionEvents. The previous session remains subscribed until replacement completes, but cancellation can interrupt before detach."),
        HistoryEntry.Tool("CreateRuleReviewIssue", "{ IssueType = \"Memory leak risk\", Severity = \"High\", Confidence = \"High\" }", "Created issue RRI-1042"),
        HistoryEntry.Tool("ListRuleReviewIssues", "No arguments", "1 issue returned"),
        HistoryEntry.Output("I submitted one RuleReviewIssue with updated ScopeCoverage and CrossScopeAnalysis.")
    ];

    private readonly HashSet<string> _expandedToolDetails = ["tool-2", "tool-9"];

    private void ToggleToolDetails(string key)
    {
        if (!_expandedToolDetails.Add(key))
        {
            _expandedToolDetails.Remove(key);
        }
    }

    private static string StatusCss(string status) => status switch
    {
        "Running" => "status-running",
        "Waiting" => "status-waiting",
        "Completed" => "status-completed",
        "Degraded" => "status-degraded",
        _ => "status-waiting"
    };

    private sealed record AgentGroup(string Id, string Name, string Status, IReadOnlyList<AgentNode> Agents);

    private sealed record AgentNode(string Name, string CreatedAt, string Status);

    private sealed record HistoryEntry(string Kind, string Message, string? ToolName, string? Arguments, string? Result)
    {
        public static HistoryEntry Input(string message) => new("Input", message, null, null, null);

        public static HistoryEntry Output(string message) => new("Output", message, null, null, null);

        public static HistoryEntry Tool(string toolName, string arguments, string result) => new("Tool", string.Empty, toolName, arguments, result);

        public static HistoryEntry Compaction(string message) => new("Compaction", message, null, null, null);
    }
}

<div class="dashboard-page agent-status-page">
    <div class="d-flex align-items-start justify-content-between gap-3">
        <div>
            <h1 class="h2 mb-0 fw-bold text-dark-emphasis">Agent Status</h1>
        </div>
    </div>

    <div class="agent-status-console">
        <aside class="agent-roster-pane">
            <div class="agent-pane-header">
                <div class="small text-uppercase fw-bold text-primary">Agents</div>
            </div>

            <div class="agent-group-list">
                @foreach (var group in _agentGroups)
                {
                    <section class="agent-group-card">
                        <div class="agent-node-list">
                            @foreach (var agent in group.Agents)
                            {
                                <div class="agent-roster-node">
                                    <div class="agent-roster-main">
                                        <div class="agent-roster-name">@agent.Name</div>
                                        <div class="agent-roster-rule">@agent.CreatedAt</div>
                                    </div>
                                    <span class="agent-status-dot @StatusCss(agent.Status)" title="@agent.Status"></span>
                                </div>
                            }
                        </div>
                    </section>
                }
            </div>
        </aside>

        <section class="agent-history-pane">
            <div class="agent-history-toolbar">
                <div>
                    <div class="agent-history-title">History</div>
                </div>
            </div>

            <div class="agent-chat-log">
                @for (var index = 0; index < _history.Count; index++)
                {
                    var entry = _history[index];
                    var isInput = entry.Kind == "Input";
                    var isTool = entry.Kind == "Tool";
                    var isCompaction = entry.Kind == "Compaction";
                    var toolKey = $"tool-{index}";
                    var isExpanded = _expandedToolDetails.Contains(toolKey);

                    @if (isCompaction)
                    {
                        <div class="agent-compaction-notice">
                            <span class="agent-compaction-rule"></span>
                            <span class="agent-compaction-label">
                                <svg class="agent-compaction-icon" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M4 1.75h5.1L12.25 4.9v9.35H4V1.75Z" />
                                    <path d="M9 1.9V5h3.1" />
                                    <path d="M5.75 8h4.5M5.75 10.25h4.5M5.75 12.5h3" />
                                </svg>
                                @entry.Message
                            </span>
                            <span class="agent-compaction-rule"></span>
                        </div>
                        continue;
                    }

                    <article class="agent-message @(isInput ? "user-message" : "agent-message-left") @(isTool ? "tool-message" : null)">
                        <div class="agent-message-bubble">
                            @if (isTool)
                            {
                                <button type="button" class="tool-call-summary" @onclick="() => ToggleToolDetails(toolKey)">
                                    <span class="tool-call-chip">Tool</span>
                                    <span class="tool-call-summary-name">@entry.ToolName</span>
                                    <span>@(isExpanded ? "v" : ">")</span>
                                </button>

                                @if (isExpanded)
                                {
                                    <div class="tool-call-item">
                                        <div class="tool-call-label">Arguments</div>
                                        <pre>@entry.Arguments</pre>
                                        <div class="tool-call-label">Result</div>
                                        <pre>@entry.Result</pre>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="agent-message-text">@entry.Message</div>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    </div>
</div>
