@page "/agent-status"
@rendermode InteractiveServer

@using System.Net
@using System.Net.Http.Json
@using CodeSnifferDog.Server.Shared.AgentStatus
@using CodeSnifferDog.Server.Shared.Projects
@inject HttpClient HttpClient

<PageTitle>Agent Status</PageTitle>

@code {
    [SupplyParameterFromQuery(Name = "projectId")]
    public Guid? ProjectId { get; set; }

    private readonly AgentStatusPageState _pageState = AgentStatusPageState.CreateEmpty();
    private bool _hasHandledParameters;
    private Guid? _loadedProjectId;

    private AgentStatusSnapshotState Snapshot => _pageState.Snapshot;

    private AgentStatusLiveConnectionState LiveConnection => _pageState.LiveConnection;

    private AgentStatusSelectionState Selection => _pageState.Selection;

    private ProjectAgentSnapshotDto? SelectedAgent =>
        Selection.SelectedAgentId is null
            ? null
            : Snapshot.FindAgent(Selection.SelectedAgentId.Value);

    private IReadOnlyList<ProjectAgentTimelineEntryDto> SelectedHistory =>
        Selection.SelectedAgentId is null
            ? []
            : Snapshot.GetHistory(Selection.SelectedAgentId.Value);

    protected override async Task OnParametersSetAsync()
    {
        if (_hasHandledParameters && _loadedProjectId == ProjectId)
            return;

        _hasHandledParameters = true;
        await LoadSnapshotAsync().ConfigureAwait(false);
    }

    private async Task LoadSnapshotAsync()
    {
        if (ProjectId is null)
        {
            _pageState.SetSnapshot(null);
            _pageState.SetSnapshotLoadState(isLoading: false, errorMessage: "No project selected.");
            _loadedProjectId = null;
            return;
        }

        _pageState.SetSnapshotLoadState(isLoading: true, errorMessage: null);
        StateHasChanged();

        try
        {
            HttpResponseMessage response = await HttpClient.GetAsync(
                $"/api/projects/{ProjectId.Value}/agent-status",
                HttpCompletionOption.ResponseHeadersRead).ConfigureAwait(false);

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                _pageState.SetSnapshot(null);
                _pageState.SetSnapshotLoadState(isLoading: false, errorMessage: "Project snapshot was not found.");
                return;
            }

            response.EnsureSuccessStatusCode();

            ProjectAgentStatusSnapshotDto? snapshot = await response.Content
                .ReadFromJsonAsync<ProjectAgentStatusSnapshotDto>()
                .ConfigureAwait(false);

            if (snapshot is null)
            {
                _pageState.SetSnapshot(null);
                _pageState.SetSnapshotLoadState(isLoading: false, errorMessage: "Project snapshot response was empty.");
                return;
            }

            _pageState.SetSnapshot(snapshot);
            _pageState.SetSnapshotLoadState(isLoading: false, errorMessage: null);
            _loadedProjectId = ProjectId;
        }
        catch (Exception exception)
        {
            _pageState.SetSnapshot(null);
            _pageState.SetSnapshotLoadState(isLoading: false, errorMessage: $"Failed to load snapshot: {exception.Message}");
        }
    }

    private void SelectAgent(Guid agentId)
    {
        Selection.SelectAgent(agentId);
    }

    private void ToggleToolDetails(string key)
    {
        Selection.ToggleToolDetails(key);
    }

    private static string StatusCss(ProjectAgentRunStatus status) => status switch
    {
        ProjectAgentRunStatus.Running => "status-running",
        ProjectAgentRunStatus.Waiting => "status-waiting",
        ProjectAgentRunStatus.Completed => "status-completed",
        ProjectAgentRunStatus.Degraded => "status-degraded",
        _ => "status-waiting"
    };

    private static string FormatStatus(ProjectAgentRunStatus status) => status switch
    {
        ProjectAgentRunStatus.Running => "Running",
        ProjectAgentRunStatus.Waiting => "Waiting",
        ProjectAgentRunStatus.Completed => "Completed",
        ProjectAgentRunStatus.Degraded => "Degraded",
        _ => "Waiting"
    };

    private static string FormatCreatedAt(DateTimeOffset createdAtUtc) => $"Created {createdAtUtc:HH:mm}";

    private sealed class AgentStatusPageState(
        AgentStatusSnapshotState snapshot,
        AgentStatusLiveConnectionState liveConnection,
        AgentStatusSelectionState selection)
    {
        public AgentStatusSnapshotState Snapshot { get; } = snapshot;

        public AgentStatusLiveConnectionState LiveConnection { get; } = liveConnection;

        public AgentStatusSelectionState Selection { get; } = selection;

        public bool IsSnapshotLoading { get; private set; }

        public string? SnapshotLoadErrorMessage { get; private set; }

        public string SnapshotLoadStatusText =>
            SnapshotLoadErrorMessage is not null
                ? "Snapshot unavailable"
                : IsSnapshotLoading
                    ? "Snapshot loading"
                    : Snapshot.Snapshot is not null
                        ? "Snapshot loaded"
                        : "Idle";

        public static AgentStatusPageState CreateEmpty() =>
            new(
                new AgentStatusSnapshotState(null),
                new AgentStatusLiveConnectionState(isConnected: false, isSubscribed: false, statusText: "Idle"),
                new AgentStatusSelectionState(selectedAgentId: null, expandedToolDetails: []));

        public void SetSnapshot(ProjectAgentStatusSnapshotDto? snapshot)
        {
            Snapshot.Replace(snapshot);
            Selection.ApplySnapshot(snapshot);
        }

        public void SetLiveConnection(bool isConnected, bool isSubscribed, string statusText)
        {
            LiveConnection.Update(isConnected, isSubscribed, statusText);
        }

        public void SetSnapshotLoadState(bool isLoading, string? errorMessage)
        {
            IsSnapshotLoading = isLoading;
            SnapshotLoadErrorMessage = errorMessage;
        }
    }

    private sealed class AgentStatusSnapshotState(ProjectAgentStatusSnapshotDto? snapshot)
    {
        public ProjectAgentStatusSnapshotDto? Snapshot { get; private set; } = snapshot;

        public IReadOnlyList<ProjectAgentGroupSnapshotDto> Groups => Snapshot?.AgentGroups ?? [];

        public void Replace(ProjectAgentStatusSnapshotDto? snapshot)
        {
            Snapshot = snapshot;
        }

        public ProjectAgentSnapshotDto? FindAgent(Guid agentId) =>
            Groups.SelectMany(group => group.Agents).FirstOrDefault(agent => agent.AgentId == agentId);

        public IReadOnlyList<ProjectAgentTimelineEntryDto> GetHistory(Guid agentId) =>
            FindAgent(agentId)?.TimelineEntries ?? [];
    }

    private sealed class AgentStatusLiveConnectionState(bool isConnected, bool isSubscribed, string statusText)
    {
        public bool IsConnected { get; private set; } = isConnected;

        public bool IsSubscribed { get; private set; } = isSubscribed;

        public string StatusText { get; private set; } = statusText;

        public void Update(bool isConnected, bool isSubscribed, string statusText)
        {
            IsConnected = isConnected;
            IsSubscribed = isSubscribed;
            StatusText = statusText;
        }
    }

    private sealed class AgentStatusSelectionState(Guid? selectedAgentId, HashSet<string> expandedToolDetails)
    {
        public Guid? SelectedAgentId { get; private set; } = selectedAgentId;

        public HashSet<string> ExpandedToolDetails { get; } = expandedToolDetails;

        public void SelectAgent(Guid agentId)
        {
            SelectedAgentId = agentId;
        }

        public void ApplySnapshot(ProjectAgentStatusSnapshotDto? snapshot)
        {
            if (snapshot is null)
            {
                SelectedAgentId = null;
                return;
            }

            bool selectedAgentStillExists =
                SelectedAgentId is not null &&
                snapshot.AgentGroups.SelectMany(group => group.Agents).Any(agent => agent.AgentId == SelectedAgentId.Value);

            if (selectedAgentStillExists)
                return;

            SelectedAgentId = snapshot.AgentGroups
                .SelectMany(group => group.Agents)
                .Select(agent => (Guid?)agent.AgentId)
                .FirstOrDefault();
        }

        public void ToggleToolDetails(string key)
        {
            if (!ExpandedToolDetails.Add(key))
            {
                ExpandedToolDetails.Remove(key);
            }
        }
    }
}

<div class="dashboard-page agent-status-page">
    <div class="d-flex align-items-start justify-content-between gap-3">
        <div>
            <h1 class="h2 mb-0 fw-bold text-dark-emphasis">Agent Status</h1>
            <div class="small text-body-secondary mt-1">@_pageState.SnapshotLoadStatusText</div>
        </div>
    </div>

    @if (_pageState.IsSnapshotLoading)
    {
        <div class="alert alert-info mt-3 mb-0" role="status">Loading agent snapshot...</div>
    }
    else if (_pageState.SnapshotLoadErrorMessage is not null)
    {
        <div class="alert alert-warning mt-3 mb-0" role="alert">@_pageState.SnapshotLoadErrorMessage</div>
    }

    <div class="agent-status-console">
        <aside class="agent-roster-pane">
            <div class="agent-pane-header">
                <div class="small text-uppercase fw-bold text-primary">Agents</div>
            </div>

            <div class="agent-group-list">
                @foreach (var group in Snapshot.Groups)
                {
                    <section class="agent-group-card">
                        <div class="agent-group-name">@group.DisplayName</div>
                        <div class="agent-node-list">
                            @foreach (var agent in group.Agents)
                            {
                                var isSelected = agent.AgentId == Selection.SelectedAgentId;

                                <button type="button"
                                        class="agent-roster-node @(isSelected ? "selected" : null)"
                                        @onclick="() => SelectAgent(agent.AgentId)">
                                    <div class="agent-roster-main">
                                        <div class="agent-roster-name">@agent.DisplayName</div>
                                        <div class="agent-roster-rule">@FormatCreatedAt(agent.CreatedAtUtc)</div>
                                    </div>
                                    <span class="agent-status-dot @StatusCss(agent.Status)" title="@FormatStatus(agent.Status)"></span>
                                </button>
                            }
                        </div>
                    </section>
                }
            </div>
        </aside>

        <section class="agent-history-pane">
            <div class="agent-history-toolbar">
                <div>
                    <div class="agent-history-title">History</div>
                    @if (SelectedAgent is not null)
                    {
                        <div class="small text-body-secondary">@SelectedAgent.DisplayName</div>
                    }
                </div>
            </div>

            <div class="agent-chat-log">
                @for (var index = 0; index < SelectedHistory.Count; index++)
                {
                    var entry = SelectedHistory[index];
                    var isInput = entry.EntryKind == ProjectAgentTimelineEntryKind.Input;
                    var isTool = entry.EntryKind == ProjectAgentTimelineEntryKind.Tool;
                    var isCompaction = entry.EntryKind == ProjectAgentTimelineEntryKind.Compaction;
                    var toolKey = entry.ToolCallId ?? entry.TimelineEntryId.ToString("N");
                    var isExpanded = Selection.ExpandedToolDetails.Contains(toolKey);

                    @if (isCompaction)
                    {
                        <div class="agent-compaction-notice">
                            <span class="agent-compaction-rule"></span>
                            <span class="agent-compaction-label">
                                <svg class="agent-compaction-icon" viewBox="0 0 16 16" aria-hidden="true">
                                    <path d="M4 1.75h5.1L12.25 4.9v9.35H4V1.75Z" />
                                    <path d="M9 1.9V5h3.1" />
                                    <path d="M5.75 8h4.5M5.75 10.25h4.5M5.75 12.5h3" />
                                </svg>
                                @entry.Message
                            </span>
                            <span class="agent-compaction-rule"></span>
                        </div>
                        continue;
                    }

                    <article class="agent-message @(isInput ? "user-message" : "agent-message-left") @(isTool ? "tool-message" : null)">
                        <div class="agent-message-bubble">
                            @if (isTool)
                            {
                                <button type="button" class="tool-call-summary" @onclick="() => ToggleToolDetails(toolKey)">
                                    <span class="tool-call-chip">Tool</span>
                                    <span class="tool-call-summary-name">@entry.ToolName</span>
                                    <span>@(isExpanded ? "v" : ">")</span>
                                </button>

                                @if (isExpanded)
                                {
                                    <div class="tool-call-item">
                                        <div class="tool-call-label">Arguments</div>
                                        <pre>@entry.ToolArguments</pre>
                                        <div class="tool-call-label">Result</div>
                                        <pre>@entry.ToolResult</pre>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="agent-message-text">@entry.Message</div>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    </div>
</div>
