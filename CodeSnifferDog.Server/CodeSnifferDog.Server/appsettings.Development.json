{
  "ConnectionStrings": {
    "CodeSnifferDogServer": "Server=(localdb)\\ProjectModels;Database=CodeSnifferDogServer.Dev;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ProjectExecution": {
    "MaxConcurrentWorkers": 1,
    "MaxQueuedProjects": 100,
    "ExecutionOptions": {
      "MaxParallelAgents": 2,
      "ModelContextWindowTokens": 128000,
      "ContextCompactionMode": "Standard"
    },
    "QueuePollingIntervalSeconds": 2
  },
  "Inference": {
    "Provider": "openai",
    "ModelId": "",
    "ApiKey": "",
    "Endpoint": "",
    "extra_body": {}
  }
}
