<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!--
      Keep the RID in the server publish profile instead of passing -r to
      dotnet publish. A global RID flows into the referenced Blazor WebAssembly
      project and makes its restore look for an invalid Mono.<server-rid>
      runtime package.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(ReleaseRuntimeIdentifier)' != ''">$(ReleaseRuntimeIdentifier)</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(ReleaseRuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
