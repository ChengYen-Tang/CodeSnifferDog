@rendermode InteractiveWebAssembly
@using CodeSnifferDog.Server.Client.Layout.Navigation
@using CodeSnifferDog.Server.Client.Services.Projects.Sidebar
@using CodeSnifferDog.Server.Shared.Projects
@inject IController SidebarSyncService
@inject NavigationManager NavigationManager

@implements IDisposable

@code {
    [Parameter]
    public ProjectSidebarSnapshotDto? InitialSnapshot { get; set; }

    private readonly HashSet<string> _actingProjectIds = [];
    private State _state = State.CreateEmpty();
    private IReadOnlyList<ProjectGroup> _groups = [];

    protected override async Task OnInitializedAsync()
    {
        SidebarSyncService.Changed += OnSidebarStateChanged;
        NavigationManager.LocationChanged += OnLocationChanged;

        if (InitialSnapshot is not null)
            SidebarSyncService.InitializeSnapshot(InitialSnapshot, ExtractProjectIdFromUri());

        RefreshSidebarProjection();

        if (CanStartInteractiveSync())
        {
            await SidebarSyncService.StartAsync(InitialSnapshot, ExtractProjectIdFromUri());
            RefreshSidebarProjection();
        }
    }

    private async void OnSidebarStateChanged()
    {
        try
        {
            await InvokeAsync(() =>
            {
                RefreshSidebarProjection();
                StateHasChanged();
            });
        }
        catch (Exception exception)
        {
            await DispatchExceptionAsync(exception);
        }
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        try
        {
            await InvokeAsync(() =>
            {
                SidebarSyncService.SyncSelectedProjectFromUri(ExtractProjectIdFromUri());
                RefreshSidebarProjection();
                StateHasChanged();
            });
        }
        catch (Exception exception)
        {
            await DispatchExceptionAsync(exception);
        }
    }

    private void ToggleGroup(ProjectGroup group)
    {
        SidebarSyncService.ToggleGroup(group.GroupKey, group.Status);
    }

    private void SelectProjectForNavigation(string projectId)
    {
        SidebarSyncService.SyncSelectedProjectFromUri(projectId);
    }

    private async Task ExecuteActionAsync(ProjectItem item, ProjectAction action)
    {
        if (!Guid.TryParse(item.ProjectId, out Guid projectId) || !_actingProjectIds.Add(item.ProjectId))
            return;

        try
        {
            switch (action.Kind)
            {
                case ProjectActionKind.Cancel:
                    await SidebarSyncService.CancelProjectAsync(projectId);
                    break;
                case ProjectActionKind.Delete:
                    bool deleted = await SidebarSyncService.DeleteProjectAsync(projectId);
                    if (deleted)
                        NavigationManager.NavigateTo("/");
                    break;
            }
        }
        finally
        {
            _actingProjectIds.Remove(item.ProjectId);
            StateHasChanged();
        }
    }

    private string? ExtractProjectIdFromUri()
    {
        Uri uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        string relativePath = NavigationManager.ToBaseRelativePath(uri.ToString()).Trim('/');
        return ProjectSidebarRouteSelection.ExtractSelectedProjectId(uri, relativePath)?.ToString();
    }

    private bool CanStartInteractiveSync()
    {
        try
        {
            return RendererInfo.IsInteractive;
        }
        catch (InvalidOperationException)
        {
            return true;
        }
    }

    private void RefreshSidebarProjection()
    {
        _state = SidebarSyncService.Current;
        _groups = SidebarProjectionBuilder.CreateGroups(_state);
    }

    public void Dispose()
    {
        SidebarSyncService.Changed -= OnSidebarStateChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

<div class="sidebar-shell">
    <div class="sidebar-brand">
        <a class="brand-main"
           href="https://github.com/ChengYen-Tang/CodeSnifferDog"
           target="_blank"
           rel="noopener noreferrer">
            <img class="brand-logo" src="images/Dog.png" alt="CodeSnifferDog" />
            <div class="brand-title">CodeSnifferDog</div>
        </a>
    </div>

    <div class="sidebar-groups">
        @if (_state.Transport.IsLoading)
        {
            <div class="sidebar-status-message">Loading projects...</div>
        }
        else if (!string.IsNullOrWhiteSpace(_state.Transport.SnapshotErrorMessage))
        {
            <div class="sidebar-status-message sidebar-status-error">@_state.Transport.SnapshotErrorMessage</div>
        }
        else if (_state.Transport.IsReconnecting)
        {
            <div class="sidebar-status-message sidebar-status-warning">Live updates reconnecting...</div>
        }
        else if (!string.IsNullOrWhiteSpace(_state.Transport.LiveErrorMessage))
        {
            <div class="sidebar-status-message sidebar-status-warning">@_state.Transport.LiveErrorMessage</div>
        }

        @foreach (var group in _groups)
        {
            <section class="status-group" @key="group.GroupKey">
                <div class="status-summary" role="button" tabindex="0" title="@group.Title" @onclick="() => ToggleGroup(group)">
                    <span class="status-heading">
                        <span class="group-icon @group.IconCssClass">@group.IconText</span>
                        <span class="group-title">@group.Title</span>
                    </span>
                    <span class="group-summary-meta">
                        <span class="group-count">@group.Items.Count</span>
                        <span class="group-chevron">@(group.IsExpanded ? "˅" : ">")</span>
                    </span>
                </div>

                @if (group.IsExpanded)
                {
                    <div class="project-list">
                        @foreach (var item in group.Items)
                        {
                            <div class="project-link @(item.ProjectId == _state.Ui.SelectedProjectId ? "active" : null)" @key="item.ProjectId">
                                <a class="project-main" href="@item.StatusHref" @onclick="() => SelectProjectForNavigation(item.ProjectId)">
                                    <span class="project-name">@item.Name</span>
                                    <span class="project-meta">@item.Meta</span>
                                </a>

                                <div class="project-actions">
                                    @foreach (var action in item.Actions)
                                    {
                                        if (action.Href is not null)
                                        {
                                            <a class="project-action-button" href="@action.Href" title="@action.Label" @key="action.Label" @onclick:stopPropagation="true">
                                                @action.IconText
                                            </a>
                                        }
                                        else
                                        {
                                            <button
                                                type="button"
                                                class="project-action-button"
                                                title="@action.Label"
                                                @key="action.Label"
                                                disabled="@_actingProjectIds.Contains(item.ProjectId)"
                                                @onclick="() => ExecuteActionAsync(item, action)"
                                                @onclick:stopPropagation="true">
                                                @action.IconText
                                            </button>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        }
    </div>

    <div class="sidebar-footer">
        <a class="add-project-button" href="/">
            <span class="add-project-plus">+</span>
            <span>Add New Project</span>
        </a>
    </div>
</div>
