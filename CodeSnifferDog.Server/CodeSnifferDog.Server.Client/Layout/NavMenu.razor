@rendermode InteractiveWebAssembly
@using CodeSnifferDog.Server.Client.Services.Projects
@using CodeSnifferDog.Server.Shared.Projects
@inject IProjectSidebarController SidebarSyncService
@inject NavigationManager NavigationManager

@implements IDisposable

@code {
    [Parameter]
    public ProjectSidebarSnapshotDto? InitialSnapshot { get; set; }

    private readonly HashSet<string> _actingProjectIds = [];
    private ProjectSidebarState _state = ProjectSidebarState.CreateEmpty();

    protected override async Task OnInitializedAsync()
    {
        SidebarSyncService.Changed += OnSidebarStateChanged;
        NavigationManager.LocationChanged += OnLocationChanged;

        if (InitialSnapshot is not null)
            SidebarSyncService.InitializeSnapshot(InitialSnapshot, ExtractProjectIdFromUri());

        _state = SidebarSyncService.Current;

        if (CanStartInteractiveSync())
        {
            await SidebarSyncService.StartAsync(InitialSnapshot, ExtractProjectIdFromUri());
            _state = SidebarSyncService.Current;
        }
    }

    private void OnSidebarStateChanged()
    {
        _ = InvokeAsync(() =>
        {
            _state = SidebarSyncService.Current;
            StateHasChanged();
        });
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(() =>
        {
            SidebarSyncService.SyncSelectedProjectFromUri(ExtractProjectIdFromUri());
            StateHasChanged();
        });
    }

    private void ToggleGroup(ProjectGroup group)
    {
        SidebarSyncService.ToggleGroup(group.GroupKey, group.Status);
    }

    private void SelectProject(string projectId)
    {
        SidebarSyncService.SelectProject(projectId);
    }

    private async Task ExecuteActionAsync(ProjectItem item, ProjectAction action)
    {
        if (!Guid.TryParse(item.ProjectId, out Guid projectId) || !_actingProjectIds.Add(item.ProjectId))
            return;

        try
        {
            switch (action.Kind)
            {
                case ProjectActionKind.Cancel:
                    await SidebarSyncService.CancelProjectAsync(projectId);
                    break;
                case ProjectActionKind.Delete:
                    await SidebarSyncService.DeleteProjectAsync(projectId);
                    break;
            }
        }
        finally
        {
            _actingProjectIds.Remove(item.ProjectId);
            StateHasChanged();
        }
    }

    private string? ExtractProjectIdFromUri()
    {
        Uri uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        string relativePath = NavigationManager.ToBaseRelativePath(uri.ToString()).Trim('/');
        return ProjectSidebarRouteSelection.ExtractSelectedProjectId(uri, relativePath)?.ToString();
    }

    private static IReadOnlyList<ProjectAction> CreateActions(Guid projectId, ProjectStatus status) => status switch
    {
        ProjectStatus.Reviewing =>
        [
            ProjectAction.Link("S", "Agent Team / Worker Status", $"/agent-status?projectId={projectId}"),
            ProjectAction.Cancel(),
        ],
        ProjectStatus.Completed =>
        [
            ProjectAction.Link("S", "Agent Team / Worker Status", $"/agent-status?projectId={projectId}"),
            ProjectAction.Link("R", "Report", $"/reports/{projectId}"),
            ProjectAction.Delete(),
        ],
        _ =>
        [
            ProjectAction.Delete(),
        ],
    };

    private bool CanStartInteractiveSync()
    {
        try
        {
            return RendererInfo.IsInteractive;
        }
        catch (InvalidOperationException)
        {
            return true;
        }
    }

    private static string GetGroupIconText(ProjectStatus status) => status switch
    {
        ProjectStatus.Reviewing => "R",
        ProjectStatus.Completed => "C",
        ProjectStatus.Queued => "Q",
        ProjectStatus.Failed => "F",
        ProjectStatus.Canceled => "C",
        _ => "?",
    };

    private static string GetGroupIconCssClass(ProjectStatus status) => status switch
    {
        ProjectStatus.Reviewing => "group-icon-reviewing",
        ProjectStatus.Completed => "group-icon-completed",
        ProjectStatus.Queued => "group-icon-queued",
        ProjectStatus.Failed => "group-icon-failed",
        ProjectStatus.Canceled => "group-icon-canceled",
        _ => string.Empty,
    };

    private sealed record ProjectAction(string IconText, string Label, ProjectActionKind Kind, string? Href)
    {
        public static ProjectAction Link(string iconText, string label, string href) =>
            new(iconText, label, ProjectActionKind.Link, href);

        public static ProjectAction Delete() =>
            new("D", "Delete", ProjectActionKind.Delete, null);

        public static ProjectAction Cancel() =>
            new("X", "Cancel", ProjectActionKind.Cancel, null);

        public static ProjectAction Disabled(string iconText, string label) =>
            new(iconText, label, ProjectActionKind.Disabled, null);
    }

    private enum ProjectActionKind
    {
        Link,
        Cancel,
        Delete,
        Disabled,
    }

    private sealed record ProjectItem(string ProjectId, string Name, string Meta, IReadOnlyList<ProjectAction> Actions);

    private sealed class ProjectGroup(
        string groupKey,
        string title,
        ProjectStatus status,
        string iconText,
        string iconCssClass,
        bool isExpanded)
    {
        public string GroupKey { get; } = groupKey;
        public string Title { get; } = title;
        public ProjectStatus Status { get; } = status;
        public string IconText { get; } = iconText;
        public string IconCssClass { get; } = iconCssClass;
        public bool IsExpanded { get; set; } = isExpanded;
        public List<ProjectItem> Items { get; init; } = [];
    }

    private IReadOnlyList<ProjectGroup> Groups =>
        _state.Snapshot.Groups
            .Select(group => new ProjectGroup(
                group.GroupKey,
                group.DisplayName,
                group.Status,
                GetGroupIconText(group.Status),
                GetGroupIconCssClass(group.Status),
                _state.Ui.IsExpanded(group.GroupKey, group.Status))
            {
                Items = group.Projects
                    .Select(project => new ProjectItem(
                        project.ProjectId.ToString(),
                        project.OriginalFileName,
                        $"uploaded {project.CreatedAtUtc.ToLocalTime():yyyy-MM-dd HH:mm}",
                        CreateActions(project.ProjectId, project.Status)))
                    .ToList(),
            })
            .ToList();

    public void Dispose()
    {
        SidebarSyncService.Changed -= OnSidebarStateChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

<div class="sidebar-shell">
    <div class="sidebar-brand">
        <div class="brand-main">
            <img class="brand-logo" src="images/Dog.png" alt="CodeSnifferDog" />
            <div class="brand-title">CodeSnifferDog</div>
        </div>
    </div>

    <div class="sidebar-groups">
        @if (_state.Transport.IsLoading)
        {
            <div class="sidebar-status-message">Loading projects...</div>
        }
        else if (!string.IsNullOrWhiteSpace(_state.Transport.SnapshotErrorMessage))
        {
            <div class="sidebar-status-message sidebar-status-error">@_state.Transport.SnapshotErrorMessage</div>
        }
        else if (_state.Transport.IsReconnecting)
        {
            <div class="sidebar-status-message sidebar-status-warning">Live updates reconnecting...</div>
        }
        else if (!string.IsNullOrWhiteSpace(_state.Transport.LiveErrorMessage))
        {
            <div class="sidebar-status-message sidebar-status-warning">@_state.Transport.LiveErrorMessage</div>
        }

        @foreach (var group in Groups)
        {
            <section class="status-group" @key="group.Title">
                <div class="status-summary" role="button" tabindex="0" title="@group.Title" @onclick="() => ToggleGroup(group)">
                    <span class="status-heading">
                        <span class="group-icon @group.IconCssClass">@group.IconText</span>
                        <span class="group-title">@group.Title</span>
                    </span>
                    <span class="group-summary-meta">
                        <span class="group-count">@group.Items.Count</span>
                        <span class="group-chevron">@(group.IsExpanded ? "˅" : ">")</span>
                    </span>
                </div>

                @if (group.IsExpanded)
                {
                    <div class="project-list">
                        @foreach (var item in group.Items)
                        {
                            <div class="project-link @(item.ProjectId == _state.Ui.SelectedProjectId ? "active" : null)" @key="item.ProjectId">
                                <button type="button" class="project-main" @onclick="() => SelectProject(item.ProjectId)">
                                    <span class="project-name">@item.Name</span>
                                    <span class="project-meta">@item.Meta</span>
                                </button>

                                <div class="project-actions">
                                    @foreach (var action in item.Actions)
                                    {
                                        if (action.Href is not null)
                                        {
                                            <a class="project-action-button" href="@action.Href" title="@action.Label" @onclick:stopPropagation="true">
                                                @action.IconText
                                            </a>
                                        }
                                        else
                                        {
                                            <button
                                                type="button"
                                                class="project-action-button"
                                                title="@action.Label"
                                                disabled="@(action.Kind is ProjectActionKind.Disabled || _actingProjectIds.Contains(item.ProjectId))"
                                                @onclick="() => ExecuteActionAsync(item, action)"
                                                @onclick:stopPropagation="true">
                                                @action.IconText
                                            </button>
                                        }
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        }
    </div>

    <div class="sidebar-footer">
        <a class="add-project-button" href="/">
            <span class="add-project-plus">+</span>
            <span>Add New Project</span>
        </a>
    </div>
</div>
