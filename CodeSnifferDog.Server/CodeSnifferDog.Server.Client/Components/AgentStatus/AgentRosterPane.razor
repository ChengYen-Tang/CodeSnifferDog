@using CodeSnifferDog.Server.Shared.AgentStatus

<aside class="agent-roster-pane">
    <div class="agent-pane-header">
        <div class="small text-uppercase fw-bold text-primary">Agents</div>
    </div>

    <div class="agent-group-list">
        @if (Groups.Count == 0)
        {
            <div class="agent-empty-state">
                <div class="agent-empty-state-title">No agents yet</div>
                <div class="agent-empty-state-copy">Agents appear here when project analysis starts.</div>
            </div>
        }
        else
        {
            @foreach (var group in Groups)
            {
                <section class="agent-group-card" @key="group.GroupId">
                    <div class="agent-group-name">@group.DisplayName</div>
                    <div class="agent-node-list">
                        @foreach (var agent in group.Agents)
                        {
                            var isSelected = agent.AgentId == SelectedAgentId;

                            <button type="button"
                                    class="agent-roster-node @(isSelected ? "selected" : null)"
                                    aria-current="@(isSelected ? "true" : null)"
                                    @key="agent.AgentId"
                                    @onclick="() => OnSelectAgent.InvokeAsync(agent.AgentId)">
                                <span class="agent-roster-main">
                                    <span class="agent-roster-name">@agent.DisplayName</span>
                                    <span class="agent-roster-rule">@FormatCreatedAt(agent.CreatedAtUtc)</span>
                                </span>
                                <span class="agent-status-dot @StatusCss(agent.Status)" title="@FormatStatus(agent.Status)">
                                    <span class="visually-hidden">@FormatStatus(agent.Status)</span>
                                </span>
                            </button>
                        }
                    </div>
                </section>
            }
        }
    </div>
</aside>

@code {
    [Parameter]
    public IReadOnlyList<GroupSnapshotDto> Groups { get; set; } = [];

    [Parameter]
    public Guid? SelectedAgentId { get; set; }

    [Parameter]
    public EventCallback<Guid> OnSelectAgent { get; set; }

    private static string StatusCss(RunStatus status) => status switch
    {
        RunStatus.Running => "status-running",
        RunStatus.Waiting => "status-waiting",
        RunStatus.Completed => "status-completed",
        RunStatus.Degraded => "status-degraded",
        _ => "status-waiting"
    };

    private static string FormatStatus(RunStatus status) => status switch
    {
        RunStatus.Running => "Running",
        RunStatus.Waiting => "Waiting",
        RunStatus.Completed => "Completed",
        RunStatus.Degraded => "Degraded",
        _ => "Waiting"
    };

    private static string FormatCreatedAt(DateTimeOffset createdAtUtc) => $"Created {createdAtUtc:HH:mm}";
}
