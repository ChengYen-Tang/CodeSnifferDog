@using CodeSnifferDog.Server.Shared.Reports

<div class="col-12 col-xl-9 col-xxl-10 reports-preview-column h-100">
    @if (IsContentLoading && SelectedReportListItem is not null)
    {
        <div class="reports-preview-shell">
            <div class="reports-preview-toolbar">
                <div>
                    <div class="reports-preview-file">@($"{SelectedReportListItem.RuleName}.md")</div>
                    <div class="reports-preview-meta">@SelectedReportListItem.RuleName</div>
                </div>
            </div>

            <div class="reports-preview-body">
                <div class="markdown-body report-reader">
                    Loading report...
                </div>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ContentErrorMessage))
    {
        <div class="reports-preview-shell">
            <div class="reports-preview-body">
                <div class="markdown-body report-reader text-danger">
                    @ContentErrorMessage
                </div>
            </div>
        </div>
    }
    else if (SelectedReportContent is not null)
    {
        <div class="reports-preview-shell">
            <div class="reports-preview-toolbar">
                <div>
                    <div class="reports-preview-file">@($"{SelectedReportContent.RuleName}.md")</div>
                    <div class="reports-preview-meta">@SelectedReportContent.RuleName</div>
                </div>
            </div>

            <div class="reports-preview-body">
                <div class="markdown-body report-reader">
                    @SelectedReportMarkup
                </div>
            </div>
        </div>
    }
    else if (!IsListLoading && string.IsNullOrWhiteSpace(ListErrorMessage))
    {
        <div class="reports-preview-shell">
            <div class="reports-preview-body">
                <div class="markdown-body report-reader">
                    No report selected.
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public bool IsContentLoading { get; set; }

    [Parameter]
    public ListItemDto? SelectedReportListItem { get; set; }

    [Parameter]
    public string? ContentErrorMessage { get; set; }

    [Parameter]
    public ContentDto? SelectedReportContent { get; set; }

    [Parameter]
    public MarkupString SelectedReportMarkup { get; set; }

    [Parameter]
    public bool IsListLoading { get; set; }

    [Parameter]
    public string? ListErrorMessage { get; set; }
}
