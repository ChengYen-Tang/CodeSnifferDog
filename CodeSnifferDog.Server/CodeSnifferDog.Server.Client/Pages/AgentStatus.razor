@page "/agent-status"
@rendermode InteractiveWebAssembly
@implements IAsyncDisposable
@implements IDisposable

@using System.Net
@using System.Net.Http.Json
@using CodeSnifferDog.Server.Client.Components.AgentStatus
@using CodeSnifferDog.Server.Client.Components.AgentStatus.State
@using CodeSnifferDog.Server.Client.Services.ProjectAgentStatus
@using CodeSnifferDog.Server.Shared.AgentStatus
@using CodeSnifferDog.Server.Shared.Projects
@inject HttpClient HttpClient
@inject ILiveSubscriptionClient LiveSubscriptionClient
@inject NavigationManager NavigationManager

<PageTitle>Agent Status</PageTitle>

@code {
    [SupplyParameterFromQuery(Name = "projectId")]
    public Guid? ProjectId { get; set; }

    private readonly PageState _pageState = PageState.CreateEmpty();
    private bool _hasHandledParameters;
    private Guid? _requestedProjectId;
    private int _reconnectReloadInProgress;
    private int _snapshotLoadVersion;
    private int _historyLoadVersion;
    private CancellationTokenSource? _snapshotLoadCancellationTokenSource;
    private bool _disposed;

    private SnapshotState Snapshot => _pageState.Snapshot;

    private LiveConnectionState LiveConnection => _pageState.LiveConnection;

    private SelectionState Selection => _pageState.Selection;

    private HistoryState History => _pageState.History;

    private SelectedAgentLiveConnectionState SelectedAgentLiveConnection => _pageState.SelectedAgentLiveConnection;

    private CompletionState Completion => _pageState.Completion;

    private SnapshotDto? SelectedAgent =>
        Selection.SelectedAgentId is null
            ? null
            : Snapshot.FindAgent(Selection.SelectedAgentId.Value);

    private IReadOnlyList<TimelineEntryDto> SelectedHistory =>
        Selection.SelectedAgentId is null || History.AgentId != Selection.SelectedAgentId
            ? []
            : History.TimelineEntries;

    protected override async Task OnParametersSetAsync()
    {
        await HandleProjectChangedAsync(ResolveRequestedProjectId()).ConfigureAwait(false);
    }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        try
        {
            await InvokeAsync(() => HandleProjectChangedAsync(ExtractProjectIdFromLocation(args.Location)));
        }
        catch (Exception exception)
        {
            await DispatchExceptionAsync(exception);
        }
    }

    private async Task HandleProjectChangedAsync(Guid? projectId)
    {
        if (_hasHandledParameters && _requestedProjectId == projectId)
            return;

        bool projectChanged = _hasHandledParameters;
        _hasHandledParameters = true;
        _requestedProjectId = projectId;
        await LoadSnapshotAsync(projectId, clearProjectContext: projectChanged).ConfigureAwait(false);
    }

    private Guid? ExtractProjectIdFromLocation(string location)
    {
        Uri uri = NavigationManager.ToAbsoluteUri(location);
        string relativePath = NavigationManager.ToBaseRelativePath(uri.ToString()).Trim('/');
        return ProjectSidebarRouteSelection.ExtractSelectedProjectId(uri, relativePath);
    }

    private Guid? ResolveRequestedProjectId()
    {
        return ExtractProjectIdFromLocation(NavigationManager.Uri) ?? ProjectId;
    }

    private async Task LoadSnapshotAsync(Guid? projectId, bool clearProjectContext = false)
    {
        int requestVersion = Interlocked.Increment(ref _snapshotLoadVersion);
        CancellationToken cancellationToken = await ReplaceSnapshotLoadCancellationTokenAsync().ConfigureAwait(false);

        if (clearProjectContext)
        {
            Interlocked.Increment(ref _historyLoadVersion);
            _pageState.BeginProjectLoad();
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            _pageState.SetSnapshotLoadState(isLoading: true, errorMessage: null);
            await InvokeAsync(StateHasChanged);
        }

        if (projectId is null)
        {
            try
            {
                await LiveSubscriptionClient.UnsubscribeAsync(cancellationToken).ConfigureAwait(false);
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                return;
            }

            if (!IsCurrentSnapshotLoad(requestVersion, projectId))
                return;

            _pageState.SetLiveConnection(isConnected: false, isSubscribed: false, statusText: "Idle");
            _pageState.SetSelectedAgentLiveConnection(agentId: null, isConnected: false, isSubscribed: false, statusText: "Idle");
            _pageState.SetLiveConnectionError(null);
            _pageState.SetSnapshot(null);
            _pageState.SetSnapshotLoadState(isLoading: false, errorMessage: "No project selected.");
            return;
        }

        if (clearProjectContext)
        {
            try
            {
                await LiveSubscriptionClient.UnsubscribeAsync(cancellationToken).ConfigureAwait(false);
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                return;
            }

            if (!IsCurrentSnapshotLoad(requestVersion, projectId))
                return;
        }

        try
        {
            string snapshotUrl = Selection.SelectedAgentId is Guid selectedAgentId
                ? $"/api/projects/{projectId.Value}/agent-status?selectedAgentId={selectedAgentId}"
                : $"/api/projects/{projectId.Value}/agent-status";

            using HttpResponseMessage response = await HttpClient.GetAsync(
                snapshotUrl,
                HttpCompletionOption.ResponseHeadersRead,
                cancellationToken).ConfigureAwait(false);

            if (!IsCurrentSnapshotLoad(requestVersion, projectId))
                return;

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                await LiveSubscriptionClient.UnsubscribeAsync(cancellationToken).ConfigureAwait(false);
                if (!IsCurrentSnapshotLoad(requestVersion, projectId))
                    return;
                _pageState.SetLiveConnection(isConnected: false, isSubscribed: false, statusText: "Snapshot unavailable");
                _pageState.SetSelectedAgentLiveConnection(Selection.SelectedAgentId, isConnected: false, isSubscribed: false, statusText: "Snapshot unavailable");
                _pageState.SetLiveConnectionError(null);
                _pageState.SetSnapshot(null);
                _pageState.SetSnapshotLoadState(isLoading: false, errorMessage: "Project snapshot was not found.");
                return;
            }

            response.EnsureSuccessStatusCode();

            StatusSnapshotDto? snapshot = await response.Content
                .ReadFromJsonAsync<StatusSnapshotDto>(cancellationToken)
                .ConfigureAwait(false);

            if (!IsCurrentSnapshotLoad(requestVersion, projectId))
                return;

            if (snapshot is null)
            {
                await LiveSubscriptionClient.UnsubscribeAsync(cancellationToken).ConfigureAwait(false);
                if (!IsCurrentSnapshotLoad(requestVersion, projectId))
                    return;
                _pageState.SetLiveConnection(isConnected: false, isSubscribed: false, statusText: "Snapshot unavailable");
                _pageState.SetSelectedAgentLiveConnection(Selection.SelectedAgentId, isConnected: false, isSubscribed: false, statusText: "Snapshot unavailable");
                _pageState.SetLiveConnectionError(null);
                _pageState.SetSnapshot(null);
                _pageState.SetSnapshotLoadState(isLoading: false, errorMessage: "Project snapshot response was empty.");
                return;
            }

            _pageState.SetSnapshot(snapshot);
            _pageState.SetSnapshotLoadState(isLoading: false, errorMessage: null);

            if (!CanStartLiveSubscriptionOnThisRender())
            {
                _pageState.SetLiveConnection(isConnected: false, isSubscribed: false, statusText: "Live pending");
                _pageState.SetSelectedAgentLiveConnection(Selection.SelectedAgentId, isConnected: false, isSubscribed: false, statusText: "Live pending");
                _pageState.SetLiveConnectionError(null);
                return;
            }

            try
            {
                await SubscribeToLiveUpdatesAsync(snapshot, cancellationToken).ConfigureAwait(false);
                if (!IsCurrentSnapshotLoad(requestVersion, projectId))
                    return;
                _pageState.SetLiveConnectionError(null);
            }
            catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
            {
                return;
            }
            catch (Exception exception)
            {
                await LiveSubscriptionClient.UnsubscribeAsync(cancellationToken).ConfigureAwait(false);
                if (!IsCurrentSnapshotLoad(requestVersion, projectId))
                    return;
                _pageState.SetLiveConnection(isConnected: false, isSubscribed: false, statusText: "Live unavailable");
                _pageState.SetSelectedAgentLiveConnection(Selection.SelectedAgentId, isConnected: false, isSubscribed: false, statusText: "Live unavailable");
                _pageState.SetLiveConnectionError($"Failed to connect live updates: {exception.Message}");
            }

        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            if (!IsCurrentSnapshotLoad(requestVersion, projectId))
                return;

            await LiveSubscriptionClient.UnsubscribeAsync(cancellationToken).ConfigureAwait(false);
            if (!IsCurrentSnapshotLoad(requestVersion, projectId))
                return;
            _pageState.SetLiveConnection(isConnected: false, isSubscribed: false, statusText: "Connection failed");
            _pageState.SetSelectedAgentLiveConnection(Selection.SelectedAgentId, isConnected: false, isSubscribed: false, statusText: "Connection failed");
            _pageState.SetLiveConnectionError(null);
            _pageState.SetSnapshot(null);
            _pageState.SetSnapshotLoadState(isLoading: false, errorMessage: $"Failed to load snapshot: {exception.Message}");
        }
    }

    private async Task SelectAgentAsync(Guid agentId)
    {
        if (Selection.SelectedAgentId == agentId)
            return;

        _pageState.SelectAgent(agentId);
        await InvokeAsync(StateHasChanged);

        try
        {
            await LiveSubscriptionClient.UnsubscribeAsync().ConfigureAwait(false);
            _pageState.SetLiveConnection(isConnected: false, isSubscribed: false, statusText: "Switching");
            _pageState.SetSelectedAgentLiveConnection(agentId, isConnected: false, isSubscribed: false, statusText: "Switching");
            _pageState.SetLiveConnectionError(null);
            await EnsureSelectedAgentHistoryAsync(agentId).ConfigureAwait(false);
        }
        catch (Exception exception)
        {
            _pageState.SetLiveConnection(isConnected: false, isSubscribed: false, statusText: "Switching");
            _pageState.SetSelectedAgentLiveConnection(agentId, isConnected: false, isSubscribed: false, statusText: "Switching");
            History.SetError(agentId, $"Failed to switch agent live updates: {exception.Message}");
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleToolDetails(string key)
    {
        Selection.ToggleToolDetails(key);
    }

    internal bool ApplyLiveUpdate(LiveUpdateDto update)
    {
        ArgumentNullException.ThrowIfNull(update);

        if (_requestedProjectId is null || update.ProjectId != _requestedProjectId.Value)
            return false;

        return _pageState.ApplyLiveUpdate(update);
    }

    private async Task SubscribeToLiveUpdatesAsync(StatusSnapshotDto snapshot, CancellationToken cancellationToken = default)
    {
        Guid? selectedAgentId = Selection.SelectedAgentId;
        LiveSubscriptionRequestDto request = new()
        {
            ProjectId = snapshot.ProjectId,
            SnapshotGeneratedAtUtc = snapshot.SnapshotGeneratedAtUtc,
            AgentId = selectedAgentId,
            LatestSequence = selectedAgentId == History.AgentId ? History.GetLatestSequence() : 0,
        };

        _pageState.SetLiveConnection(isConnected: false, isSubscribed: false, statusText: "Connecting");
        _pageState.SetSelectedAgentLiveConnection(selectedAgentId, isConnected: false, isSubscribed: false, statusText: "Connecting");
        StateHasChanged();

        await LiveSubscriptionClient.SubscribeAsync(
            request,
            update =>
            {
                return ApplyLiveUpdate(update)
                    ? InvokeAsync(StateHasChanged)
                    : Task.CompletedTask;
            },
            HandleReconnectingAsync,
            HandleReconnectRequiredAsync,
            cancellationToken).ConfigureAwait(false);

        _pageState.SetLiveConnection(isConnected: true, isSubscribed: true, statusText: "Live");
        _pageState.SetSelectedAgentLiveConnection(selectedAgentId, isConnected: true, isSubscribed: true, statusText: "Live");
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        NavigationManager.LocationChanged -= OnLocationChanged;
        await CancelSnapshotLoadAsync().ConfigureAwait(false);
        await LiveSubscriptionClient.DisposeAsync().ConfigureAwait(false);
    }

    public void Dispose()
    {
        _disposed = true;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private async Task<CancellationToken> ReplaceSnapshotLoadCancellationTokenAsync()
    {
        await CancelSnapshotLoadAsync().ConfigureAwait(false);
        _snapshotLoadCancellationTokenSource = new CancellationTokenSource();
        return _snapshotLoadCancellationTokenSource.Token;
    }

    private async Task CancelSnapshotLoadAsync()
    {
        CancellationTokenSource? cancellationTokenSource = Interlocked.Exchange(
            ref _snapshotLoadCancellationTokenSource,
            null);
        if (cancellationTokenSource is null)
            return;

        await cancellationTokenSource.CancelAsync().ConfigureAwait(false);
        cancellationTokenSource.Dispose();
    }

    private bool IsCurrentSnapshotLoad(int requestVersion, Guid? projectId) =>
        !_disposed &&
        requestVersion == Volatile.Read(ref _snapshotLoadVersion) &&
        _requestedProjectId == projectId;

    private async Task HandleReconnectRequiredAsync()
    {
        if (_disposed || _requestedProjectId is null)
            return;

        if (Interlocked.Exchange(ref _reconnectReloadInProgress, 1) == 1)
            return;

        try
        {
            await InvokeAsync(async () =>
            {
                _pageState.SetLiveConnection(isConnected: false, isSubscribed: false, statusText: "Reconnecting");
                _pageState.SetSelectedAgentLiveConnection(Selection.SelectedAgentId, isConnected: false, isSubscribed: false, statusText: "Reconnecting");
                _pageState.SetLiveConnectionError("Live connection interrupted. Reloading snapshot...");
                StateHasChanged();
                await LoadSnapshotAsync(_requestedProjectId);
            });
        }
        finally
        {
            Interlocked.Exchange(ref _reconnectReloadInProgress, 0);
        }
    }

    private Task HandleReconnectingAsync()
    {
        if (_disposed || _requestedProjectId is null)
            return Task.CompletedTask;

        return InvokeAsync(() =>
        {
            _pageState.SetLiveConnection(isConnected: false, isSubscribed: false, statusText: "Reconnecting");
            _pageState.SetSelectedAgentLiveConnection(Selection.SelectedAgentId, isConnected: false, isSubscribed: false, statusText: "Reconnecting");
            _pageState.SetLiveConnectionError("Live connection interrupted. Reconnecting...");
            StateHasChanged();
        });
    }

    private Task EnsureSelectedAgentHistoryAsync(Guid agentId)
    {
        SnapshotDto? agent = Snapshot.FindAgent(agentId);
        if (agent is null)
            return Task.CompletedTask;

        if (agent.HasLoadedHistory)
        {
            History.ClearError();
            return InvokeAsync(async () =>
            {
                await SubscribeToLiveUpdatesAsync(Snapshot.Snapshot!).ConfigureAwait(false);
                StateHasChanged();
            });
        }

        return LoadAgentHistoryAsync(agentId);
    }

    private async Task LoadAgentHistoryAsync(Guid agentId)
    {
        if (_requestedProjectId is not Guid projectId)
            return;

        int requestVersion = Interlocked.Increment(ref _historyLoadVersion);
        History.StartLoading(agentId);
        await InvokeAsync(StateHasChanged);

        try
        {
            HistorySnapshotDto? history = await HttpClient.GetFromJsonAsync<HistorySnapshotDto>(
                $"/api/projects/{projectId}/agent-status/agents/{agentId}/history").ConfigureAwait(false);

            if (!IsCurrentHistoryRequest(requestVersion, projectId, agentId))
                return;

            if (history is null)
            {
                History.SetError(agentId, "Agent history response was empty.");
                return;
            }

            _pageState.SetAgentHistory(history.AgentId, history.TimelineEntries);
            await SubscribeToLiveUpdatesAsync(Snapshot.Snapshot!).ConfigureAwait(false);
        }
        catch (Exception exception)
        {
            if (!IsCurrentHistoryRequest(requestVersion, projectId, agentId))
                return;

            History.SetError(agentId, $"Failed to load agent history: {exception.Message}");
        }
        finally
        {
            if (IsCurrentHistoryRequest(requestVersion, projectId, agentId))
            {
                History.FinishLoading(agentId);
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private bool IsCurrentHistoryRequest(int requestVersion, Guid projectId, Guid agentId) =>
        requestVersion == _historyLoadVersion &&
        _requestedProjectId == projectId &&
        Selection.SelectedAgentId == agentId;

    private bool CanStartLiveSubscriptionOnThisRender()
    {
        try
        {
            return RendererInfo.IsInteractive;
        }
        catch (InvalidOperationException)
        {
            // bUnit does not always provide RendererInfo unless explicitly configured.
            return true;
        }
    }


}

<div class="dashboard-page agent-status-page">
    <div class="d-flex align-items-start justify-content-between gap-3">
        <div>
            <h1 class="h2 mb-0 fw-bold text-dark-emphasis">Agent Status</h1>
            <div class="small text-body-secondary mt-1">@_pageState.SnapshotLoadStatusText</div>
            <div class="mt-2 d-flex align-items-center gap-2">
                <span class="badge @Completion.BadgeCss agent-completion-badge">@Completion.BadgeText</span>
                <span class="small text-body-secondary agent-completion-detail">@Completion.DetailText</span>
            </div>
        </div>
    </div>

    @if (_pageState.IsSnapshotLoading)
    {
        <div class="alert alert-info mt-3 mb-0" role="status">Loading agent snapshot...</div>
    }
    else if (_pageState.SnapshotLoadErrorMessage is not null)
    {
        <div class="alert alert-warning mt-3 mb-0" role="alert">@_pageState.SnapshotLoadErrorMessage</div>
    }

    @if (_pageState.LiveConnectionErrorMessage is not null)
    {
        <div class="alert alert-warning mt-3 mb-0" role="alert">@_pageState.LiveConnectionErrorMessage</div>
    }

    <div class="agent-status-console">
        <AgentRosterPane Groups="@Snapshot.Groups"
                         SelectedAgentId="@Selection.SelectedAgentId"
                         OnSelectAgent="@SelectAgentAsync" />

        <AgentHistoryPane SelectedAgent="@SelectedAgent"
                          SelectedAgentId="@Selection.SelectedAgentId"
                          HistoryAgentId="@History.AgentId"
                          IsHistoryLoading="@History.IsLoading"
                          HistoryErrorMessage="@History.ErrorMessage"
                          TimelineEntries="@SelectedHistory"
                          ExpandedToolDetails="@Selection.ExpandedToolDetails"
                          OnToggleToolDetails="@ToggleToolDetails" />
    </div>

    <AgentSystemPromptModal Agent="@SelectedAgent" SystemPrompt="@SelectedAgent?.SystemPrompt" />
</div>
