@page "/reports/{ProjectId:guid}"
@rendermode InteractiveAuto
@using System.Net.Http.Json
@using CodeSnifferDog.Server.Shared.Reports
@using Markdig
@inject HttpClient Http

<PageTitle>Reports</PageTitle>

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private readonly MarkdownPipeline _markdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    private ProjectReportBundleDto? _bundle;
    private ProjectRuleReportDto? _selectedReport;
    private bool _isLoading = true;
    private string? _errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            _bundle = await Http.GetFromJsonAsync<ProjectReportBundleDto>($"/api/projects/{ProjectId}/reports");
            _selectedReport = _bundle?.Reports.FirstOrDefault();
        }
        catch (Exception exception)
        {
            _bundle = null;
            _selectedReport = null;
            _errorMessage = $"Failed to load reports: {exception.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SelectReport(ProjectRuleReportDto report) => _selectedReport = report;

    private MarkupString RenderMarkdown(string markdown) =>
        new(Markdown.ToHtml(markdown, _markdownPipeline));
}

<div class="dashboard-page reports-page">
    <div class="d-flex flex-column gap-2">
        <h1 class="h2 mb-0 fw-bold text-dark-emphasis">Reports</h1>
    </div>

    <div class="card border-0 shadow-sm dashboard-card reports-explorer-card flex-grow-1">
        <div class="row g-0 reports-explorer">
            <div class="col-12 col-xl-3 col-xxl-2 reports-sidebar-column h-100">
                <div class="reports-sidebar">
                    <div class="reports-sidebar-header">
                        <div class="d-flex align-items-start justify-content-between gap-2">
                            <div>
                                <h2 class="h5 mb-1 text-dark-emphasis">@(_bundle?.OriginalFileName ?? "Reports")</h2>
                                <p class="text-secondary mb-0">@((_bundle?.Reports.Count ?? 0).ToString()) markdown reports available</p>
                            </div>
                            @if (_bundle is not null && _bundle.Reports.Count > 0)
                            {
                                <a class="project-action-button"
                                   href="@($"/api/projects/{ProjectId}/reports/download")"
                                   title="Download all reports as zip">
                                    ZIP
                                </a>
                            }
                        </div>
                    </div>

                    <div class="reports-file-list">
                        @if (_isLoading)
                        {
                            <div class="text-secondary">Loading reports...</div>
                        }
                        else if (!string.IsNullOrWhiteSpace(_errorMessage))
                        {
                            <div class="text-danger">@_errorMessage</div>
                        }
                        else if (_bundle is null || _bundle.Reports.Count == 0)
                        {
                            <div class="text-secondary">No reports available for this project.</div>
                        }
                        else
                        {
                            @foreach (ProjectRuleReportDto report in _bundle.Reports)
                            {
                                <div class="report-file-item @(ReferenceEquals(report, _selectedReport) ? "active" : null)">
                                    <button type="button"
                                            class="report-file-select"
                                            @onclick="() => SelectReport(report)">
                                        <span class="report-file-icon">MD</span>
                                        <span class="report-file-body">
                                            <span class="report-file-name">@($"{report.RuleName}.md")</span>
                                            <span class="report-file-category">@report.RuleName</span>
                                        </span>
                                    </button>
                                    <a class="report-file-download"
                                       href="@($"/api/projects/{ProjectId}/reports/{report.ReportId}/download")"
                                       title="Download report"
                                       download="@($"{report.RuleName}.md")">
                                        ↓
                                    </a>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-9 col-xxl-10 reports-preview-column h-100">
                @if (_selectedReport is not null)
                {
                    <div class="reports-preview-shell">
                        <div class="reports-preview-toolbar">
                            <div>
                                <div class="reports-preview-file">@($"{_selectedReport.RuleName}.md")</div>
                                <div class="reports-preview-meta">@_selectedReport.RuleName</div>
                            </div>
                        </div>

                        <div class="reports-preview-body report-reader markdown-body">
                            @RenderMarkdown(_selectedReport.MarkdownContent)
                        </div>
                    </div>
                }
                else if (!_isLoading && string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="reports-preview-shell">
                        <div class="reports-preview-body report-reader markdown-body">
                            No report selected.
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
