@page "/reports/{ProjectId:guid}"
@rendermode InteractiveAuto
@implements IDisposable
@using System.Net.Http.Json
@using CodeSnifferDog.Server.Shared.Reports
@using Markdig
@inject HttpClient Http
@inject PersistentComponentState PersistentComponentState

<PageTitle>Reports</PageTitle>

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private readonly MarkdownPipeline _markdownPipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    private PersistingComponentStateSubscription? _persistingSubscription;
    private ProjectReportListDto? _reportList;
    private ProjectReportContentDto? _selectedReportContent;
    private Guid? _selectedReportId;
    private Guid? _loadedProjectId;
    private int _contentRequestVersion;
    private bool _isListLoading = true;
    private bool _isContentLoading;
    private string? _listErrorMessage;
    private string? _contentErrorMessage;

    protected override void OnInitialized()
    {
        _persistingSubscription = PersistentComponentState.RegisterOnPersisting(PersistComponentState);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedProjectId == ProjectId)
            return;

        _loadedProjectId = ProjectId;

        if (TryRestoreComponentState())
            return;

        await LoadReportListAsync();
    }

    private ProjectReportListItemDto? SelectedReportListItem =>
        _selectedReportId is null || _reportList is null
            ? null
            : _reportList.Reports.FirstOrDefault(report => report.ReportId == _selectedReportId.Value);

    private async Task LoadReportListAsync()
    {
        _isListLoading = true;
        _listErrorMessage = null;
        _contentErrorMessage = null;

        try
        {
            _reportList = await Http.GetFromJsonAsync<ProjectReportListDto>($"/api/projects/{ProjectId}/reports");
            _selectedReportContent = null;
            _selectedReportId = null;

            ProjectReportListItemDto? firstReport = _reportList?.Reports.FirstOrDefault();
            if (firstReport is not null)
                await LoadReportContentAsync(firstReport.ReportId);
        }
        catch (Exception exception)
        {
            _reportList = null;
            _selectedReportContent = null;
            _selectedReportId = null;
            _listErrorMessage = $"Failed to load reports: {exception.Message}";
        }
        finally
        {
            _isListLoading = false;
        }
    }

    private Task SelectReportAsync(ProjectReportListItemDto report)
    {
        if (_selectedReportId == report.ReportId
            && _selectedReportContent?.ReportId == report.ReportId
            && !_isContentLoading
            && string.IsNullOrWhiteSpace(_contentErrorMessage))
            return Task.CompletedTask;

        return LoadReportContentAsync(report.ReportId);
    }

    private async Task LoadReportContentAsync(Guid reportId)
    {
        int requestVersion = Interlocked.Increment(ref _contentRequestVersion);
        _selectedReportId = reportId;
        _selectedReportContent = null;
        _contentErrorMessage = null;
        _isContentLoading = true;
        StateHasChanged();

        try
        {
            ProjectReportContentDto? reportContent = await Http.GetFromJsonAsync<ProjectReportContentDto>(
                $"/api/projects/{ProjectId}/reports/{reportId}");

            if (!IsCurrentContentRequest(requestVersion, reportId))
                return;

            _selectedReportContent = reportContent;
            if (_selectedReportContent is null)
                _contentErrorMessage = "Report content response was empty.";
        }
        catch (Exception exception)
        {
            if (!IsCurrentContentRequest(requestVersion, reportId))
                return;

            _contentErrorMessage = $"Failed to load report content: {exception.Message}";
        }
        finally
        {
            if (IsCurrentContentRequest(requestVersion, reportId))
                _isContentLoading = false;
        }
    }

    private MarkupString RenderMarkdown(string markdown) =>
        new(Markdown.ToHtml(markdown, _markdownPipeline));

    private bool TryRestoreComponentState()
    {
        string reportListKey = CreateReportListStateKey();
        string selectedReportContentKey = CreateSelectedReportContentStateKey();

        if (!PersistentComponentState.TryTakeFromJson<ProjectReportListDto>(reportListKey, out ProjectReportListDto? reportList))
            return false;

        if (!PersistentComponentState.TryTakeFromJson<ProjectReportContentDto>(selectedReportContentKey, out ProjectReportContentDto? selectedReportContent))
            return false;

        _reportList = reportList;
        _selectedReportContent = selectedReportContent;
        _selectedReportId = selectedReportContent.ReportId;
        _isListLoading = false;
        _isContentLoading = false;
        _listErrorMessage = null;
        _contentErrorMessage = null;
        return true;
    }

    private Task PersistComponentState()
    {
        if (_reportList is not null)
            PersistentComponentState.PersistAsJson(CreateReportListStateKey(), _reportList);

        if (_selectedReportContent is not null)
            PersistentComponentState.PersistAsJson(CreateSelectedReportContentStateKey(), _selectedReportContent);

        return Task.CompletedTask;
    }

    private string CreateReportListStateKey() => $"reports:list:{ProjectId}";

    private string CreateSelectedReportContentStateKey() => $"reports:selected-content:{ProjectId}";

    private bool IsCurrentContentRequest(int requestVersion, Guid reportId) =>
        requestVersion == _contentRequestVersion && _selectedReportId == reportId;

    public void Dispose()
    {
        _persistingSubscription?.Dispose();
    }
}

<div class="dashboard-page reports-page">
    <div class="d-flex flex-column gap-2">
        <h1 class="h2 mb-0 fw-bold text-dark-emphasis">Reports</h1>
    </div>

    <div class="card border-0 shadow-sm dashboard-card reports-explorer-card flex-grow-1">
        <div class="row g-0 reports-explorer">
            <div class="col-12 col-xl-3 col-xxl-2 reports-sidebar-column h-100">
                <div class="reports-sidebar">
                    <div class="reports-sidebar-header">
                        <div class="d-flex align-items-start justify-content-between gap-2">
                            <div>
                                <h2 class="h5 mb-1 text-dark-emphasis">@(_reportList?.OriginalFileName ?? "Reports")</h2>
                                <p class="text-secondary mb-0">@((_reportList?.Reports.Count ?? 0).ToString()) markdown reports available</p>
                            </div>
                            @if (_reportList is not null && _reportList.Reports.Count > 0)
                            {
                                <a class="project-action-button"
                                   href="@($"/api/projects/{ProjectId}/reports/download")"
                                   title="Download all reports as zip">
                                    ZIP
                                </a>
                            }
                        </div>
                    </div>

                    <div class="reports-file-list">
                        @if (_isListLoading)
                        {
                            <div class="text-secondary">Loading reports...</div>
                        }
                        else if (!string.IsNullOrWhiteSpace(_listErrorMessage))
                        {
                            <div class="text-danger">@_listErrorMessage</div>
                        }
                        else if (_reportList is null || _reportList.Reports.Count == 0)
                        {
                            <div class="text-secondary">No reports available for this project.</div>
                        }
                        else
                        {
                            @foreach (ProjectReportListItemDto report in _reportList.Reports)
                            {
                                <div class="report-file-item @(_selectedReportId == report.ReportId ? "active" : null)">
                                    <button type="button"
                                            class="report-file-select"
                                            @onclick="() => SelectReportAsync(report)">
                                        <span class="report-file-icon">MD</span>
                                        <span class="report-file-body">
                                            <span class="report-file-name">@($"{report.RuleName}.md")</span>
                                            <span class="report-file-category">@report.RuleName</span>
                                        </span>
                                    </button>
                                    <a class="report-file-download"
                                       href="@($"/api/projects/{ProjectId}/reports/{report.ReportId}/download")"
                                       title="Download report"
                                       download="@($"{report.RuleName}.md")">
                                        ↓
                                    </a>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-9 col-xxl-10 reports-preview-column h-100">
                @if (_isContentLoading && SelectedReportListItem is not null)
                {
                    <div class="reports-preview-shell">
                        <div class="reports-preview-toolbar">
                            <div>
                                <div class="reports-preview-file">@($"{SelectedReportListItem.RuleName}.md")</div>
                                <div class="reports-preview-meta">@SelectedReportListItem.RuleName</div>
                            </div>
                        </div>

                        <div class="reports-preview-body report-reader markdown-body">
                            Loading report...
                        </div>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_contentErrorMessage))
                {
                    <div class="reports-preview-shell">
                        <div class="reports-preview-body report-reader markdown-body text-danger">
                            @_contentErrorMessage
                        </div>
                    </div>
                }
                else if (_selectedReportContent is not null)
                {
                    <div class="reports-preview-shell">
                        <div class="reports-preview-toolbar">
                            <div>
                                <div class="reports-preview-file">@($"{_selectedReportContent.RuleName}.md")</div>
                                <div class="reports-preview-meta">@_selectedReportContent.RuleName</div>
                            </div>
                        </div>

                        <div class="reports-preview-body report-reader markdown-body">
                            @RenderMarkdown(_selectedReportContent.MarkdownContent)
                        </div>
                    </div>
                }
                else if (!_isListLoading && string.IsNullOrWhiteSpace(_listErrorMessage))
                {
                    <div class="reports-preview-shell">
                        <div class="reports-preview-body report-reader markdown-body">
                            No report selected.
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
