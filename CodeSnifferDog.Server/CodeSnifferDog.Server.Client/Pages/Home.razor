@page "/"
@rendermode InteractiveAuto

<PageTitle>New Project</PageTitle>

<div class="dashboard-page">
    <div class="d-flex flex-column gap-2">
        <h1 class="h2 fw-bold mb-0 text-dark-emphasis">New Project</h1>
        <p class="text-secondary mb-0">Create a new analysis job from a zipped repository upload.</p>
    </div>

    <div class="card border-0 shadow-sm dashboard-card">
        <div class="card-body p-4 p-xl-5">
            <form class="row g-4">
                <div class="col-12">
                    <div class="row g-4">
                        <div class="col-12">
                            <label class="form-label fw-semibold text-dark-emphasis" for="project-name">Project Name</label>
                            <input id="project-name" class="form-control form-control-lg" type="text" placeholder="Payment.Service" />
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold text-dark-emphasis mb-3">Zip Archive</label>
                            <label class="upload-dropzone w-100" for="project-zip">
                                <input id="project-zip" class="d-none" type="file" accept=".zip" />
                                <span class="badge rounded-pill text-bg-primary px-3 py-2">.zip only</span>
                                <div class="upload-title">Drop archive here or click to browse</div>
                                <div class="upload-subtitle">Single project package upload for server-side analysis.</div>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="d-flex justify-content-end">
                        <button type="button" class="btn btn-primary btn-lg px-4 upload-action-button">Upload Project</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
