@page "/"
@rendermode InteractiveAuto

@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager

<script type="module" src="@Assets["Pages/Home.razor.js"]"></script>

<PageTitle>New Project</PageTitle>

@code {
    private const string UploadInputElementId = "new-project-zip-input";
    private const string UploadDropzoneElementId = "new-project-dropzone";

    private IBrowserFile? _selectedFile;
    private bool _isUploading;
    private string? _errorMessage;
    private string? _selectedArchiveDisplayName;

    private bool HasSelectedArchive => _selectedFile is not null;

    private string UploadButtonText => _isUploading ? "Uploading..." : "Upload Project";

    private async Task HandleSelectedFileAsync(InputFileChangeEventArgs args)
    {
        IBrowserFile? selectedFile = args.FileCount > 0 ? args.File : null;
        _errorMessage = null;

        if (selectedFile is null)
        {
            _selectedFile = null;
            _selectedArchiveDisplayName = null;
            return;
        }

        if (!string.Equals(Path.GetExtension(selectedFile.Name), ".zip", StringComparison.OrdinalIgnoreCase))
        {
            _selectedFile = null;
            _selectedArchiveDisplayName = null;
            _errorMessage = "Only .zip uploads are supported.";
            return;
        }

        _selectedFile = selectedFile;
        _selectedArchiveDisplayName = $"{selectedFile.Name} ({FormatFileSize(selectedFile.Size)})";
        await InvokeAsync(StateHasChanged);
    }

    private async Task UploadProjectAsync()
    {
        if (_isUploading)
            return;

        if (_selectedFile is null)
        {
            _errorMessage = "Choose a .zip archive before uploading.";
            return;
        }

        _isUploading = true;
        _errorMessage = null;

        try
        {
            ProjectUploadResponse? uploadResponse = await JsRuntime.InvokeAsync<ProjectUploadResponse>(
                "codeSnifferDogProjectUpload.upload",
                UploadInputElementId,
                "/api/projects/");

            if (uploadResponse is null)
            {
                _errorMessage = "The upload completed, but the server response was empty.";
                return;
            }

            if (!uploadResponse.Success)
            {
                _errorMessage = uploadResponse.Message ?? "Upload failed.";
                return;
            }

            NavigationManager.NavigateTo($"/agent-status?projectId={uploadResponse.ProjectId}");
        }
        catch (Exception exception)
        {
            _errorMessage = $"Failed to upload project: {exception.Message}";
        }
        finally
        {
            _isUploading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string FormatFileSize(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB"];
        double size = bytes;
        int unitIndex = 0;

        while (size >= 1024 && unitIndex < units.Length - 1)
        {
            size /= 1024;
            unitIndex++;
        }

        return $"{size:0.#} {units[unitIndex]}";
    }

    private sealed class ProjectUploadResponse
    {
        public bool Success { get; init; }
        public string? Message { get; init; }
        public Guid ProjectId { get; init; }
        public string? OriginalFileName { get; init; }
    }
}

<div class="dashboard-page">
    <div class="d-flex flex-column gap-2">
        <h1 class="h2 fw-bold mb-0 text-dark-emphasis">New Project</h1>
        <p class="text-secondary mb-0">Create a new analysis job from a zipped repository upload.</p>
    </div>

    <div class="card border-0 shadow-sm dashboard-card">
        <div class="card-body p-4 p-xl-5">
            <div class="row g-4">
                <div class="col-12">
                    <div class="row g-4">
                        <div class="col-12">
                            <label class="form-label fw-semibold text-dark-emphasis" for="new-project-selected-archive">Selected Archive</label>
                            <input
                                id="new-project-selected-archive"
                                class="form-control form-control-lg"
                                type="text"
                                value="@(_selectedArchiveDisplayName ?? "No archive selected")"
                                readonly />
                        </div>

                        <div class="col-12">
                            <div class="form-label fw-semibold text-dark-emphasis mb-3">Zip Archive</div>
                            <label class="upload-dropzone w-100" id="@UploadDropzoneElementId" for="@UploadInputElementId">
                                <InputFile
                                    id="@UploadInputElementId"
                                    class="visually-hidden"
                                    accept=".zip"
                                    aria-describedby="new-project-upload-help"
                                    OnChange="HandleSelectedFileAsync" />
                                <span class="badge rounded-pill text-bg-primary px-3 py-2">.zip only</span>
                                <div class="upload-title">Drop archive here or click to browse</div>
                                <div id="new-project-upload-help" class="upload-subtitle">Single project package upload for server-side analysis.</div>
                                @if (HasSelectedArchive)
                                {
                                    <div class="upload-selection-note">@_selectedArchiveDisplayName</div>
                                }
                            </label>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <div class="col-12">
                    <div class="alert alert-warning mb-0" role="alert">@_errorMessage</div>
                    </div>
                }

                <div class="col-12">
                    <div class="d-flex justify-content-end">
                        <button
                            type="button"
                            class="btn btn-primary btn-lg px-4 upload-action-button"
                            disabled="@(_isUploading || !HasSelectedArchive)"
                            @onclick="UploadProjectAsync">
                            @UploadButtonText
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
